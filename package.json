{
  "name": "einvoice-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Turns Shopify orders into legally valid invoices for Spain (Verifactu), with a free invoice checker.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite web --host",
    "build": "vite build web",
    "preview": "vite preview web --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
